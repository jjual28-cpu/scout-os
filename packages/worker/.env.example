# Scout Worker — local environment (never commit the real file)
# Runs on YOUR machine and needs the service-role key to claim jobs (bypasses RLS).

# Supabase (Project → Settings → API)
SUPABASE_URL="https://YOUR-PROJECT-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# Worker behavior (optional)
WORKER_POLL_INTERVAL_MS="5000"     # how often to poll for pending jobs
WORKER_RESULT_LIMIT="20"           # target creators per job (first goal: 20)
WORKER_MAX_ATTEMPTS="3"            # per-job attempts before giving up
WORKER_HEADLESS="false"           # false = visible Chrome window (recommended locally)
WORKER_BROWSER_CHANNEL="chrome"   # use installed Chrome; blank "" = Playwright's bundled chromium

# Chrome profile (keeps the Instagram login session + cookies between runs).
# Enabled by default. Uses a DEDICATED Scout profile — a separate user-data-dir
# that never conflicts with your everyday Chrome (no need to close Chrome). Log in
# to Instagram once in this profile and the session is reused afterward.
WORKER_USE_PROFILE="true"          # false = ephemeral browser (no saved login)
# WORKER_USER_DATA_DIR=""          # dedicated Scout user-data-dir. Defaults to
                                   # %LOCALAPPDATA%\ScoutWorker\chrome-profile (auto-created)
WORKER_CHROME_PROFILE="Default"    # which profile inside it: "Default", "Profile 1", ...
