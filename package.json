{
  "name": "scout-os",
  "version": "0.1.0",
  "private": true,
  "description": "Scout OS — an AI employee that discovers business opportunities before you do.",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,mjs,cjs}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,mjs,cjs}\"",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "turbo run db:generate",
    "db:migrate": "pnpm --filter @scout-os/database db:migrate",
    "db:push": "pnpm --filter @scout-os/database db:push",
    "db:studio": "pnpm --filter @scout-os/database db:studio",
    "db:seed": "pnpm --filter @scout-os/database db:seed",
    "prepare": "husky"
  },
  "devDependencies": {
    "@scout-os/config": "workspace:*",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "turbo": "^2.1.3",
    "typescript": "^5.6.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,mjs,cjs,css}": [
      "prettier --write"
    ]
  }
}
