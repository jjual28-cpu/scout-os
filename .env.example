# =============================================================================
# Scout OS — Environment Variables
#
# Local dev:  copy this file to `apps/web/.env` and fill in values.
# Vercel:     add these in Project → Settings → Environment Variables.
#
# NEVER commit real secrets. Only NEXT_PUBLIC_* vars are exposed to the browser.
# All variables here are validated at boot by apps/web/src/lib/env.ts.
# =============================================================================

# -----------------------------------------------------------------------------
# App (public)
# -----------------------------------------------------------------------------
# In production set NEXT_PUBLIC_APP_URL to your deployed URL (e.g. Vercel domain).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Scout OS"

# -----------------------------------------------------------------------------
# Supabase — OPTIONAL. Leave blank to run in mock mode (localStorage only).
# Set these (Project → Settings → API) to enable real auth (/login, /signup) and
# per-account data sync of saved opportunities, status, memo, and DM drafts
# across devices. The service-role key bypasses RLS — server-only, never public.
#
# The URL + anon key are enough for auth + sync (the browser uses RLS). Before it
# works, apply supabase/migrations/0001_mvp_user_data.sql in the SQL editor.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# -----------------------------------------------------------------------------
# Database (Prisma → Supabase Postgres) — OPTIONAL. Only the DB-backed scaffolds
# use this; the MVP sync uses the Supabase JS client above, not Prisma.
# DATABASE_URL → pooled connection (PgBouncer, port 6543) used at runtime.
# DIRECT_URL   → direct connection (port 5432) used for migrations.
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres.YOUR-PROJECT-ref:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.YOUR-PROJECT-ref:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# -----------------------------------------------------------------------------
# AI providers — OPTIONAL. Not used by the MVP (DM drafts are a local template).
# Needed only when wiring real AI analysis / DM generation.
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
AI_DEFAULT_PROVIDER="anthropic"
AI_DEFAULT_MODEL="claude-sonnet-5"

# 검색/DM 판정용 AI (runAi). 우선순위: GOOGLE_AI_API_KEY > OPENROUTER_API_KEY.
#  - GOOGLE_AI_API_KEY: Google AI Studio(aistudio.google.com → Get API key). 무료
#    티어라 카드 불필요. 설정하면 OpenRouter 대신 무료 Gemini 로 판정한다.
#  - OPENROUTER_API_KEY: openrouter.ai. 유료(크레딧). 여러 모델 접근.
# 둘 중 하나만 있어도 AI 판정이 켜진다. 없으면 "AI 미설정"으로 규칙만으로 동작.
GOOGLE_AI_API_KEY=""
GOOGLE_AI_MODEL="gemini-2.0-flash"
OPENROUTER_API_KEY=""

# -----------------------------------------------------------------------------
# Discovery provider — OPTIONAL, SERVER-ONLY. Selects how /discover sources
# Instagram creators:
#   worker → enqueue a job for the local Playwright worker (packages/worker).
#            The worker collects public accounts on your own laptop and writes to
#            `discovered_creators`; the app reads them. RECOMMENDED. Requires the
#            Supabase vars above and running the worker (see packages/worker).
#   apify  → run the Apify actor inline (requires APIFY_API_TOKEN below).
#   mock   → always show mock data.
# Unset ⇒ auto: Apify if APIFY_API_TOKEN is set, else mock.
# -----------------------------------------------------------------------------
DISCOVERY_PROVIDER="worker"

# -----------------------------------------------------------------------------
# Apify — OPTIONAL, SERVER-ONLY (never prefix with NEXT_PUBLIC). Alternate
# discovery provider, used only when DISCOVERY_PROVIDER="apify". Unset ⇒ Apify
# path is inactive. Token: apify.com → Settings → Integrations → API token.
# APIFY_INSTAGRAM_ACTOR overrides the actor (default: apify~instagram-scraper).
# -----------------------------------------------------------------------------
APIFY_API_TOKEN=""
APIFY_INSTAGRAM_ACTOR="apify~instagram-scraper"

# -----------------------------------------------------------------------------
# Background jobs — OPTIONAL. Secret for protecting future cron endpoints.
# -----------------------------------------------------------------------------
CRON_SECRET=""

# -----------------------------------------------------------------------------
# Instagram — OPTIONAL. 셀럽 답장을 앱에서 받고(웹훅) DM을 보내려면 필요.
# "Instagram API with Instagram login" (developers.facebook.com → 앱 → Instagram).
#   - INSTAGRAM_APP_ID / INSTAGRAM_APP_SECRET: 앱 대시보드의 Instagram 앱 ID·시크릿
#   - INSTAGRAM_WEBHOOK_VERIFY_TOKEN: 임의 문자열. Meta 웹훅 설정의 Verify Token 과 동일하게
#   - NEXT_PUBLIC_INSTAGRAM_APP_ID: 위 APP_ID 와 동일값(클라 노출용)
# OAuth redirect: <NEXT_PUBLIC_APP_URL>/api/instagram/callback
# Webhook callback: <NEXT_PUBLIC_APP_URL>/api/instagram/webhook (field: messages)
# 셋 다 있어야 인스타 기능이 켜진다(isInstagramConfigured). 없으면 조용히 비활성.
# -----------------------------------------------------------------------------
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=""
NEXT_PUBLIC_INSTAGRAM_APP_ID=""
