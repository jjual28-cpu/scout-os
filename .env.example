# =============================================================================
# Scout OS — Environment Variables
#
# Local dev:  copy this file to `apps/web/.env` and fill in values.
# Vercel:     add these in Project → Settings → Environment Variables.
#
# NEVER commit real secrets. Only NEXT_PUBLIC_* vars are exposed to the browser.
# All variables here are validated at boot by apps/web/src/lib/env.ts.
# =============================================================================

# -----------------------------------------------------------------------------
# App (public)
# -----------------------------------------------------------------------------
# In production set NEXT_PUBLIC_APP_URL to your deployed URL (e.g. Vercel domain).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Scout OS"

# -----------------------------------------------------------------------------
# Supabase — OPTIONAL. Leave blank to run in mock mode (localStorage only).
# Set these (Project → Settings → API) to enable real auth (/login, /signup) and
# per-account data sync of saved opportunities, status, memo, and DM drafts
# across devices. The service-role key bypasses RLS — server-only, never public.
#
# The URL + anon key are enough for auth + sync (the browser uses RLS). Before it
# works, apply supabase/migrations/0001_mvp_user_data.sql in the SQL editor.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# -----------------------------------------------------------------------------
# Database (Prisma → Supabase Postgres) — OPTIONAL. Only the DB-backed scaffolds
# use this; the MVP sync uses the Supabase JS client above, not Prisma.
# DATABASE_URL → pooled connection (PgBouncer, port 6543) used at runtime.
# DIRECT_URL   → direct connection (port 5432) used for migrations.
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres.YOUR-PROJECT-ref:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.YOUR-PROJECT-ref:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# -----------------------------------------------------------------------------
# AI providers — OPTIONAL. Not used by the MVP (DM drafts are a local template).
# Needed only when wiring real AI analysis / DM generation.
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
AI_DEFAULT_PROVIDER="anthropic"
AI_DEFAULT_MODEL="claude-sonnet-5"

# -----------------------------------------------------------------------------
# Apify — OPTIONAL, SERVER-ONLY (never prefix with NEXT_PUBLIC). Enables real
# Instagram creator discovery on /discover. Unset ⇒ /discover shows mock data.
# Token: apify.com → Settings → Integrations → API token.
# APIFY_INSTAGRAM_ACTOR overrides the actor (default: apify~instagram-scraper).
# -----------------------------------------------------------------------------
APIFY_API_TOKEN=""
APIFY_INSTAGRAM_ACTOR="apify~instagram-scraper"

# -----------------------------------------------------------------------------
# Background jobs — OPTIONAL. Secret for protecting future cron endpoints.
# -----------------------------------------------------------------------------
CRON_SECRET=""
